#!/usr/bin/env bash

cache="${XDG_RUNTIME_DIR:-/tmp}/herdr-waybar.status"
yellow='#f3be7c'
blue='#7e98e8'
red='#d8647e'
green='#7fa563'
frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

i=0
last_refresh=0

while :; do
	now=$(date +%s)
	if (( now != last_refresh )); then
		last_refresh=$now
		mtime=$(stat -c %Y "$cache" 2>/dev/null) || mtime=0
		if (( now - mtime >= 3 )); then
			if output=$(herdr workspace list 2>/dev/null); then
				jq -r '[.result.workspaces[0].agent_status // "idle",
				        ([.result.workspaces[] | "\(.number):\(.label)"] | join(", "))][]
				       ' <<<"$output" >"$cache.new" 2>/dev/null \
					&& mv "$cache.new" "$cache"
			else
				rm -f "$cache"
			fi
		fi
	fi

	{
		read -r status
		read -r workspaces
	} <"$cache" 2>/dev/null

	if [[ -n $workspaces ]]; then
		case "$status" in
			working) color=$yellow; spinner=${frames[$i]} ;;
			blocked) color=$red;    spinner='▪' ;;
			*)       color=$blue;   spinner='▪' ;;
		esac
		text="<span color='$color'>$spinner</span> herdr: $workspaces"
		printf '{"text":"%s","tooltip":"Agent: %s\\nWorkspaces: %s","class":"herdr-%s","markup":"pango"}\n' \
			"$text" "$status" "$workspaces" "$status"
	else
		printf '{"text":"","class":"herdr-idle"}\n'
	fi

	i=$(((i + 1) % ${#frames[@]}))
	sleep 0.1
done
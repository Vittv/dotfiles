{
    "layer": "top",
    "position": "top",
    "margin-top": 6,
    "margin-right": 8,
    "margin-left": 8,
    "height": 40,
    "spacing": 10,
    "reload_style_on_change": true,
    
    "modules-left": ["custom/power", "hyprland/workspaces"],
    "modules-center": ["custom/clock"],
    "modules-right": ["tray", "custom/cpu-temp", "custom/gpu-temp", "network", "pulseaudio", "custom/menu"],
    
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": [1, 2]
        }
    },

    "custom/cpu-temp": {
        "exec": "sensors | grep 'Tctl:' | awk '{print int($2)}' | tr -d '+°C'",
        "format": "󰍛 {}°C",
        "tooltip-format": "CPU {}°C",
        "interval": 5
    },

    "custom/gpu-temp": {
        "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",  // For NVIDIA
        // "exec": "cat /sys/class/drm/card0/device/hwmon/hwmon*/temp1_input | awk '{print $1/1000}'",  // For AMD
        "format": "󰾲 {}°C",
        "tooltip-format": "GPU {}°C",
        "interval": 5,
        "return-type": ""
    },

    "tray": {
      "icon-size": 20,
      "spacing": 10,
    },

    "network": {
        "format-wifi": "󰤨 wifi",
        "format-ethernet": "󰈀 et",
        "format-disconnected": "󰤮 ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "Connected {ipaddr}/{cidr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },
    
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "{volume}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol"
    },

    "custom/clock": {
      "exec": "~/.config/waybar/scripts/clock.sh",
      "interval": 30,
      "on-click": "gnome-calendar"
    },
    
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout"
    },

    "custom/spotify": {
        "format": "♫ {}",
        "max-length": 20,
        "interval": 1,
        "exec": "playerctl -p spotify volume 2>/dev/null | awk '{printf \"%.0f%% \", $1*100}' && playerctl -p spotify metadata --format '{{ artist }} - {{ title }}' 2>/dev/null | sed 's/&/&amp;/g; s/</&lt;/g; s/>/&gt;/g' || echo ''",
        "exec-if": "playerctl -p spotify status 2>/dev/null",
        "on-click": "playerctl -p spotify next",
        "on-click-right": "playerctl -p spotify previous",
        "on-click-middle": "playerctl -p spotify play-pause",
        "on-scroll-up": "playerctl -p spotify volume 0.05+",
        "on-scroll-down": "playerctl -p spotify volume 0.05-"
    },

    "custom/menu": {
      "format": "󰂚 ",
      "on-click": "swaync-client -t -sw"
    }
}

{
  "layer": "top",
  "position": "top",
  "spacing": 10,
    // "margin-top": 4,
    // "margin-left": 4,
    // "margin-right": 4,
    "reload_style_on_change": true,
    "modules-left": ["custom/microphone", "hyprland/workspaces", "custom/tmux", "custom/devserver", "custom/spotify"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "group/temps", "custom/mudfish", "network", "pulseaudio", "custom/inbox", "custom/power"],

    "custom/palette": {
      "format": "Tools",
      "on-click": "COLOR=$(hyprpicker -a) && notify-send 'Palette 🎨' \"<b>$COLOR</b> copied to clipboard\""
    },

    "custom/microphone": {
      "format": "{}",
      "exec": "IS_MUTED=$(pactl get-source-mute @DEFAULT_SOURCE@ | grep -o 'yes'); if [ \"$IS_MUTED\" = \"yes\" ]; then echo '{\"text\":\"\",\"class\":\"muted\",\"tooltip\":\"Microphone: Muted\"}'; else echo '{\"text\":\"\",\"class\":\"unmuted\",\"tooltip\":\"Microphone: Active\"}'; fi",
      "on-click": "pactl set-source-mute alsa_input.pci-0000_05_00.6.pro-input-0 toggle && pkill -RTMIN+8 waybar",
      "return-type": "json",
      "interval": "once",
      "signal": 8,
      "tooltip": true
    },

    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "ignore-hidden": true,
      "all-outputs": false,
      "active-only": true,
      "cursor": true
    },

    "hyprland/window": {
      "format": "{initialTitle}",
      "separate-outputs": false,
      "rewrite": {
        "^$": "Apps"
      },
      "on-click": "rofi -show drun"
    },

    "custom/tmux": {
      "exec": "sessions=$(tmux list-sessions -F '#{session_created} #S' 2>/dev/null | sort -n | cut -d' ' -f2- | awk '{n=split($0,a,\"/\"); if(n>2){r=a[1]; for(i=2;i<=2;i++) r=r\"/\"a[i]; print r\"…\"} else print $0}' | awk '{print NR\":\"$0}' | paste -sd ',' - | sed 's/,/, /g'); if [ -n \"$sessions\" ]; then echo \"{\\\"text\\\": \\\"  $sessions\\\", \\\"class\\\": \\\"tmux-active\\\", \\\"tooltip\\\": \\\"Tmux sessions: $sessions\\\"}\"; fi",
      "return-type": "json",
      "interval": 2,
      "format": "tmux:{}",
      "on-click": "kitty fish -c t"
    },

    "custom/devserver": {
      "exec": "servers=''; if ss -tlnp 2>/dev/null | grep -q ':5173 '; then servers='vite:5173'; fi; if ss -tlnp 2>/dev/null | grep -q ':4173 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}vite:4173\"; fi; if ss -tlnp 2>/dev/null | grep -q ':8080 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}webpack:8080\"; fi; if ss -tlnp 2>/dev/null | grep -q ':3000 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}dev:3000\"; fi; if ss -tlnp 2>/dev/null | grep -q ':8081 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}dev:8081\"; fi; if [ -n \"$servers\" ]; then echo \"{\\\"text\\\": \\\"$servers\\\", \\\"class\\\": \\\"server-active\\\", \\\"tooltip\\\": \\\"Dev servers: $servers\\\"}\"; fi",
      "return-type": "json",
      "interval": 3,
      "format": "{}",
      "on-click": "bash -c 'port=$(ss -tlnp 2>/dev/null | grep -oP \":(5173|4173|8080|3000|8081) \" | head -1 | tr -d \": \"); [ -n \"$port\" ] && xdg-open \"http://localhost:$port\"'"
    },

    "custom/mudfish": {
      "exec": "$HOME/.config/waybar/src/mudfish-status.sh",
      "interval": 2,
      "format": "{}",
      "tooltip": true,
      "return-type": "json",
      "on-click": "setsid -f /home/vitt/.config/waybar/src/mudfish-start.sh",
      "on-click-right": "setsid -f sudo /home/vitt/.config/waybar/src/mudfish-stop.sh"
    },

    "tray": {
      "icon-size": 14,
      "spacing": 6
    },

    "group/temps": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 300,
        "children-class": "hidden",
        "transition-left-to-right": false
      },
      "modules": ["custom/drawer-icon", "custom/cpu-temp", "custom/gpu-temp"]
    },

    "custom/drawer-icon": {
      "format": "",
      "tooltip": false
    },

    "custom/cpu-temp": {
      "exec": "sensors | grep 'Tctl:' | awk '{print int($2)}' | tr -d '+°C'",
      "format": "{}°C",
      "tooltip-format": "CPU {}°C",
      "interval": 5,
      "cursor": true,
      "on-click": "kitty btop"
    },

    "custom/gpu-temp": {
      "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",  // For NVIDIA
      "format": "{}°C",
      "tooltip-format": "GPU {}°C",
      "interval": 5,
      "cursor": true,
      "on-click": "kitty btop"
    },

    "bluetooth": {
      "format": "󰂯",
      "format-disabled": "󰂲",
      "format-connected": "󰂱",
      "tooltip-format": "Bluetooth: {status}",
      "tooltip-format-connected": "Connected to {device_alias}",
      "on-click": "blueman-manager"
    },

    "network": {
      "format-wifi": "󰤨",
      "format-ethernet": "",
      "format-linked": "󰈂 rip",
      "format-disconnected": "󰤮 dc",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
      "tooltip-format-ethernet": "Connected {ipaddr}/{cidr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
      "tooltip-format-disconnected": "Disconnected",
      "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "",
      "format-icons": {
        "default": ["", "", ""]
      },
      "tooltip-format": "VOL {volume}%",
      "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "on-click-right": "pavucontrol"
    },

    "clock": {
      "format": "{:%d  •  %I:%M %p}",
      "tooltip-format": "<span font='JetBrainsMono Nerd Font Medium 10' size='14000'>{calendar}</span>",
      "calendar": {
        "mode": "month",
        "format": {
          "months": "<span color='#bb9dbd'>{}</span>",
          "weekdays": "<span color='#7e98e8'>{}</span>",
          "days": "<span color='#cdcdcd'>{}</span>",
          "today": "<span color='#f3be7c'>{}</span>"
        }
      },
      "cursor": "true",
      "on-click": "gnome-calendar"
    },  

    "custom/power": {
      "format": "󰍃",
      "on-click": "~/.local/bin/powermenu.sh",
      "tooltip-format": "Power Menu"
    },

    "custom/spotify": {
      "format": "{}",
      "max-length": 35,
      "return-type": "json",
      "interval": 1,
      "escape": false,
      "exec": "~/.config/waybar/src/spotify.sh",
      "exec-if": "~/.config/waybar/src/spotify-detect.sh",
      "on-click": "~/.config/waybar/src/spotify-ctl.sh next",
      "on-click-right": "~/.config/waybar/src/spotify-ctl.sh previous",
      "on-click-middle": "~/.config/waybar/src/spotify-ctl.sh play-pause",
      "on-scroll-up": "~/.config/waybar/src/spotify-ctl.sh volume 0.05+",
      "on-scroll-down": "~/.config/waybar/src/spotify-ctl.sh volume 0.05-"
    },

    "custom/separator": {
      "format": "|"
    },

    "custom/inbox": {
      "format": "󰂚",
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "on-click-middle": "swaync-client -C",
      "tooltip-format": "Notifications",
      "escape": true
    }
},

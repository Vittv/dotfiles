{
  "layer": "top",
  "position": "top",
  "spacing": 4,
    // "margin-top": 6,
    // "margin-left": 6,
    // "margin-right": 6,
    "reload_style_on_change": true,
    "modules-left": ["custom/microphone", "hyprland/workspaces", "group/dev-tools", "custom/navidrome", "custom/spotify"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/mudfish", "bluetooth", "network", "pulseaudio", "custom/power"],

    "custom/microphone": {
      "format": "{}",
      "exec": "IS_MUTED=$(pactl get-source-mute @DEFAULT_SOURCE@ | grep -o 'yes'); if [ \"$IS_MUTED\" = \"yes\" ]; then echo '{\"text\":\"\",\"class\":\"muted\",\"tooltip\":\"Microphone: Muted\"}'; else echo '{\"text\":\"\",\"class\":\"unmuted\",\"tooltip\":\"Microphone: Active\"}'; fi",
      "on-click": "pactl set-source-mute alsa_input.pci-0000_05_00.6.pro-input-0 toggle && pkill -RTMIN+8 waybar",
      "return-type": "json",
      "interval": "once",
      "signal": 8,
      "tooltip": true
    },

    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "ignore-hidden": true,
      "all-outputs": false,
      "active-only": true,
      "cursor": true,
      "persistent-workspaces": {
        "DP-1": [1, 2, 3, 4],
        "HDMI-A-1": [5, 6]
      }
    },

    "hyprland/window": {
      "format": "{initialTitle}",
      "separate-outputs": true,
      "align": 0,
      "rewrite": {
        "^$": "Apps"
      },
      "on-click": "rofi -show drun"
    },

    "group/dev-tools": {
      "orientation": "inherit",
      "modules": ["custom/herdr", "custom/tmux"]
    },

    "custom/herdr": {
      "exec": "~/.config/waybar/src/herdr.sh",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "escape": false,
      "tooltip": true,
      "on-click": "kitty herdr"
    },

    "custom/tmux": {
      "exec": "sessions=$(tmux list-sessions -F '#{session_created} #S' 2>/dev/null | sort -n | cut -d' ' -f2- | awk '{n=split($0,a,\"/\"); if(n>2){r=a[1]; for(i=2;i<=2;i++) r=r\"/\"a[i]; print r\"…\"} else print $0}' | awk '{print NR\":\"$0}' | paste -sd ',' - | sed 's/,/, /g'); if [ -n \"$sessions\" ]; then echo \"{\\\"text\\\": \\\"tmux: $sessions\\\", \\\"class\\\": \\\"tmux-active\\\", \\\"tooltip\\\": \\\"Tmux sessions: $sessions\\\"}\"; fi",
      "return-type": "json",
      "interval": 2,
      "format": "{}",
      "on-click": "kitty fish -c t"
    },

    "custom/devserver": {
      "exec": "servers=''; if ss -tlnp 2>/dev/null | grep -q ':5173 '; then servers='vite:5173'; fi; if ss -tlnp 2>/dev/null | grep -q ':4173 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}vite:4173\"; fi; if ss -tlnp 2>/dev/null | grep -q ':8080 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}webpack:8080\"; fi; if ss -tlnp 2>/dev/null | grep -q ':3000 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}dev:3000\"; fi; if ss -tlnp 2>/dev/null | grep -q ':8081 '; then [ -n \"$servers\" ] && servers=\"$servers, \" || servers=''; servers=\"${servers}dev:8081\"; fi; if [ -n \"$servers\" ]; then echo \"{\\\"text\\\": \\\"<span color='#7e98e8'>▪</span> $servers\\\", \\\"class\\\": \\\"server-active\\\", \\\"tooltip\\\": \\\"Dev servers: $servers\\\", \\\"markup\\\": \\\"pango\\\"}\"; fi",
      "return-type": "json",
      "interval": 3,
      "format": "{}",
      "escape": false,
      "on-click": "bash -c 'port=$(ss -tlnp 2>/dev/null | grep -oP \":(5173|4173|8080|3000|8081) \" | head -1 | tr -d \": \"); [ -n \"$port\" ] && xdg-open \"http://localhost:$port\"'"
    },

    "custom/mudfish": {
      "exec": "~/.config/waybar/src/mudfish.sh",
      "interval": 2,
      "format": "{}",
      "tooltip": true,
      "return-type": "json",
      "on-click": "setsid -f /home/vitt/.local/bin/mudfish-start.sh",
      "on-click-right": "setsid -f sudo /home/vitt/.local/bin/mudfish-stop.sh"
    },

    "tray": {
      "icon-size": 12,
      "spacing": 6
    },

    "group/temps": {
      "orientation": "inherit",
      "modules": ["custom/cpu-temp", "custom/temp-sep",  "custom/gpu-temp"]
    },

    "custom/temp-sep": {
      "format": "•",
      "tooltip": false
    },

    "custom/cpu-temp": {
      "exec": "sensors | grep 'Tctl:' | awk '{print int($2)}' | tr -d '+°C'",
      "format": "{}°C",
      "tooltip-format": "CPU {}°C",
      "interval": 5,
      "cursor": true,
      "on-click": "kitty btop"
    },

    "custom/gpu-temp": {
      "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
      "format": "{}°C",
      "tooltip-format": "GPU {}°C",
      "interval": 5,
      "cursor": true,
      "on-click": "kitty btop"
    },

    "bluetooth": {
      "format": "",
      "format-connected": "<span foreground='#7fa563'>▪</span> bt",
      "tooltip-format": "Bluetooth: {status}",
      "tooltip-format-connected": "Connected to {device_alias}",
      "on-click": "blueman-manager"
    },

    "network": {
      "format-wifi": "󰤨",
      "format-ethernet": "",
      "format-linked": "󰈁",
      "format-disconnected": "󰌙",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
      "tooltip-format-ethernet": "Connected {ipaddr}/{cidr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
      "tooltip-format-disconnected": "Disconnected",
      "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "muted",
      "format-icons": {
        "default": ["", "", ""]
      },
      "tooltip-format": "VOL {volume}%",
      "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "on-click-right": "pavucontrol"
    },

    "clock": {
      "format": "{:%d  •  %I:%M %p}",
      "tooltip-format": "<span font='JetBrainsMono Nerd Font Medium 10' size='14000'>{calendar}</span>",
      "calendar": {
        "mode": "month",
        "format": {
          "months": "<span color='#bb9dbd'>{}</span>",
          "weekdays": "<span color='#7e98e8'>{}</span>",
          "days": "<span color='#cdcdcd'>{}</span>",
          "today": "<span color='#f3be7c'>{}</span>"
        }
      },
      "on-click": "gnome-calendar"
    },

    "custom/power": {
      "format": "󰍃",
      "on-click": "~/.local/bin/powermenu.sh",
      "tooltip-format": "Power Menu"
    },

    "custom/spotify": {
      "format": "{}",
      "align": -1,
      "return-type": "json",
      "interval": 1,
      "escape": false,
      "exec": "~/.config/waybar/src/spotify.sh",
      "on-click": "~/.config/waybar/src/spotify-ctl.sh next",
      "on-click-right": "~/.config/waybar/src/spotify-ctl.sh previous",
      "on-click-middle": "~/.config/waybar/src/spotify-ctl.sh play-pause",
      "on-scroll-up": "~/.config/waybar/src/spotify-ctl.sh volume 0.01+",
      "on-scroll-down": "~/.config/waybar/src/spotify-ctl.sh volume 0.01-"
    },

    "custom/navidrome": {
      "format": "{}",
      "align": 0,
      "return-type": "json",
      "interval": 1,
      "escape": false,
      "exec": "~/.config/waybar/src/navidrome.sh",
      "on-click": "~/.config/waybar/src/navidrome-ctl.sh next",
      "on-click-right": "~/.config/waybar/src/navidrome-ctl.sh previous",
      "on-click-middle": "~/.config/waybar/src/navidrome-ctl.sh play-pause",
      "on-scroll-up": "~/.config/waybar/src/navidrome-ctl.sh volume 5%+",
      "on-scroll-down": "~/.config/waybar/src/navidrome-ctl.sh volume 5%-"
    },

    "custom/separator": {
      "format": "|"
    },

    "custom/menu": {
      "format": "\ueae7",
      // "format": "",
      "on-click": "rofi -show drun"
    }
}

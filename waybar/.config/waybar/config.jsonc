{
    "layer": "bottom",
    "position": "top",
    "spacing": 12,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces", "custom/separator", "custom/microphone", "custom/spotify"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/separator", "custom/mudfish", "bluetooth", "network", "pulseaudio", "custom/menu", "custom/power"],
   
    "custom/menu": {
      "format": "{icon}",
      "format-icons": {
          "notification": "󱅫",
          "none": "󰂚",
          "dnd-notification": "󰂛",
          "dnd-none": "󰪑"
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "on-click-middle": "swaync-client -C",
      "tooltip-format": "Notifications",
      "escape": true
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        },
        "cursor": true
    },

    "custom/mudfish": {
      "exec": "if pgrep -x 'mudfish.sh' > /dev/null 2>&1; then echo '{\"text\":\"󰱓\", \"tooltip\":\"Mudfish VPN is ON\", \"class\":\"on\"}'; else echo '{\"text\":\"󰲛\", \"tooltip\":\"Mudfish VPN is OFF\", \"class\":\"off\"}'; fi",
      "interval": 5,
      "format": "{}",
      "tooltip": true,
      "return-type": "json"
    },

    "custom/cpu-temp": {
        "exec": "sensors | grep 'Tctl:' | awk '{print int($2)}' | tr -d '+°C'",
        "format": "󰉊 {}°C",
        "tooltip-format": "CPU {}°C",
        "interval": 5,
        "cursor": true,
        "on-click": "kitty btop"
    },

    "custom/gpu-temp": {
        "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",  // For NVIDIA
        // "exec": "cat /sys/class/drm/card0/device/hwmon/hwmon*/temp1_input | awk '{print $1/1000}'",  // For AMD
        "format": "󰏘 {}°C",
        "tooltip-format": "GPU {}°C",
        "interval": 5,
        "cursor": true,
        "on-click": "kitty btop"
    },

    "tray": {
      "icon-size": 20,
      "spacing": 10,
    },
    
    "bluetooth": {
      "format": "󰂯",
      "format-disabled": "󰂲",
      "format-connected": "󰂱",
      "tooltip-format": "Bluetooth: {status}",
      "tooltip-format-connected": "Connected to {device_alias}",
      "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "",
        "format-linked": "󰈂 rip",
        "format-disconnected": "󰤮 dc",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "Connected {ipaddr}/{cidr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },
    
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "VOL {volume}%",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "custom/microphone": {
        "format": "{}",
        "exec": "IS_MUTED=$(pactl get-source-mute @DEFAULT_SOURCE@ | grep -o 'yes'); if [ \"$IS_MUTED\" = \"yes\" ]; then echo '{\"text\":\"\",\"class\":\"muted\",\"tooltip\":\"Microphone: Muted\"}'; else echo '{\"text\":\"\",\"class\":\"unmuted\",\"tooltip\":\"Microphone: Active\"}'; fi",
        "on-click": "pactl set-source-mute alsa_input.pci-0000_05_00.6.pro-input-0 toggle && pkill -RTMIN+8 waybar",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true
    },
 
    "clock": {
        "format": "{:%b %d   %I:%M %p}",
        "tooltip-format": "<span size='15000'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#F5C2E7'>{}</span>",
                "weekdays": "<span color='#89B4FA'>{}</span>",
                "days": "<span color='#CDD6F4'>{}</span>",
                "today": "<span color='#F9E2AF'>{}</span>"
            }
        },
        "cursor": "true",
        "on-click": "gnome-calendar"
    },  

    "custom/power": {
      "format": "⏼",
      "on-click": "~/.local/bin/powermenu.sh",
      "tooltip-format": "Power Menu"
    },

    "custom/spotify": {
      "format": "{}",
      "interval": 1,
      "max-length": 40,
      "return-type": "json",
      "exec": "status=$(playerctl -p spotify status 2>/dev/null); vol=$(playerctl -p spotify volume 2>/dev/null | awk '{printf \"%.0f%%\", $1*100}'); info=$(playerctl -p spotify metadata --format '{{ artist }} - {{ title }}' 2>/dev/null | sed 's/\"/\\\\\"/g' | sed 's/&/&amp;/g' | sed 's/</&lt;/g' | sed 's/>/&gt;/g'); icon='󰓇'; [[ \"$status\" == \"Paused\" ]] && icon='⏸'; echo \"{\\\"text\\\":\\\"$icon $vol $info\\\",\\\"tooltip\\\":\\\"$vol $status: $info\\\"}\" || echo '{\"text\":\"\",\"tooltip\":\"\"}'",      "exec-if": "playerctl -p spotify status 2>/dev/null",
      "on-click": "playerctl -p spotify next",
      "on-click-right": "playerctl -p spotify previous",
      "on-click-middle": "playerctl -p spotify play-pause",
      "on-scroll-up": "playerctl -p spotify volume 0.05+",
      "on-scroll-down": "playerctl -p spotify volume 0.05-"
    },
    
    "custom/separator": {
      "format": "|"
    }

},

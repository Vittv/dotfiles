#!/usr/bin/env bash
SCROLL_LEN=30
DELAY=0.3

detect() {
  line=$(playerctl -p spotify metadata --format '{{ artist }} — {{ title }} ' 2>/dev/null)
  if [ -z "$line" ]; then
    for p in $(playerctl -l 2>/dev/null); do
      trackid=$(playerctl -p "$p" metadata mpris:trackid 2>/dev/null)
      url=$(playerctl -p "$p" metadata xesam:url 2>/dev/null)
      if echo "$trackid$url" | grep -qi spotify; then
        line=$(playerctl -p "$p" metadata --format '{{ artist }} — {{ title }} ' 2>/dev/null)
        break
      fi
    done
  fi
  echo "$line"
}

prev=""
while true; do
  line=$(detect)
  if [ -z "$line" ]; then
    printf "%${SCROLL_LEN}s\n" ""
    sleep $DELAY
    continue
  fi
  [ "$line" != "$prev" ] && buf="$line" && prev="$line"
  if [ ${#buf} -le $SCROLL_LEN ]; then
    printf "%-${SCROLL_LEN}s\n" "$buf"
    sleep $DELAY
    continue
  fi
  full="$buf   $buf"
  printf "%s\n" "${full:0:$SCROLL_LEN}"
  buf="${buf:1}${buf:0:1}"
  sleep $DELAY
done

#!/usr/bin/env bash

# configuration
TRACKED_DIRS=(
  "$HOME/Documents"
  "$HOME/dev"
  "$HOME/dotfiles"
  "/mnt/drive"
)

BCV_PATH=$(realpath "$0")
CACHE_FILE="/tmp/bcv_preview_$USER.txt"

normalize_path() {
  echo "$1" | sed "s|^$HOME|~|"
}

expand_path() {
  echo "$1" | sed "s|^~|$HOME|"
}

scan_vault() {
  for dir in "${TRACKED_DIRS[@]}"; do
    [[ ! -d "$dir" ]] && continue

    if [[ "$dir" == "$HOME/dotfiles" ]]; then
       find "$dir" -maxdepth 1 -mindepth 1 -type d ! -name ".git"
    elif [[ "$dir" == "/mnt/drive" ]]; then
       find "$dir" -maxdepth 1 -mindepth 1 -type d ! -name "backup"
       [[ -d "$dir/backup" ]] && find "$dir/backup" -maxdepth 1 -mindepth 1 -type d
    else
       find "$dir" -maxdepth 2 -name ".git" -type d -prune | sed 's|/\.git||'
    fi
  done | awk -F/ '{
    # Sort key: parent path | hidden (0) or normal (1) | name | full path
    parent = ""; for(i=1; i<NF; i++) parent = parent $i "/";
    is_hidden = ($NF ~ /^\./) ? "0" : "1";
    print parent "|" is_hidden "|" $NF "|" $0
  }' | sort -t'|' -k1,1 -k2,2 -k3,3 | cut -d'|' -f4
}

get_git_status_info() {
  local path=$(expand_path "$1")
  local repo_root=""

  if [[ -d "$path/.git" ]]; then
    repo_root="$path"
  else
    repo_root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)
  fi

  if [[ -z "$repo_root" ]]; then
    printf "34\t\e[34m󰉋\e[0m\tNo Repo" 
    return
  fi

  local status=$(git -C "$repo_root" status --porcelain -- "$path" 2>/dev/null)
  local ahead=$(git -C "$repo_root" rev-list --count @{u}..HEAD 2>/dev/null)

  if [[ -n "$status" ]]; then
    printf "35\t\e[35m*\e[0m\tModified"
  elif [[ "$ahead" -gt 0 ]]; then
    printf "34\t\e[34m󰶣\e[0m\tUnpushed"
  else
    printf "32\t\e[32m󰄬\e[0m\tSynced"
  fi
}

generate_cache() {
  local v_blue="\e[34m"
  local v_cyan="\e[36m"
  local v_dim="\e[2m"
  local v_reset="\e[0m"

  printf "${v_dim}%-30s %-15s %s${v_reset}\n" "DIRECTORY" "STATUS" "REMOTE" > "$CACHE_FILE"
  printf "${v_dim}%s${v_reset}\n" "$(printf '%.0s─' {1..80})" >> "$CACHE_FILE"

  mapfile -t all_paths < <(scan_vault)
  local last_parent=""

  for raw_path in "${all_paths[@]}"; do
    local path=$(normalize_path "$raw_path")
    local parent=$(dirname "$path")
    local name=$(basename "$path")

    if [[ "$parent" != "$last_parent" ]]; then
      printf "\n${v_blue}%s${v_reset}\n" "$parent" >> "$CACHE_FILE"
      last_parent="$parent"
    fi

    IFS=$'\t' read -r status_code glyph status_text < <(get_git_status_info "$raw_path")
    
    local repo_root=$(git -C "$(expand_path "$raw_path")" rev-parse --show-toplevel 2>/dev/null)
    local remote_url=""
    [[ -n "$repo_root" ]] && remote_url=$(git -C "$repo_root" remote get-url origin 2>/dev/null | sed -e 's|\.git$||' -e 's|git@github.com:|https://github.com/|')

    local remote_display
    if [[ -n "$remote_url" ]]; then
        remote_display="${v_cyan}${remote_url}${v_reset}"
    else
        remote_display="${v_dim}---${v_reset}"
    fi
    
    printf "  %-28s %b %-12s %b\n" \
      "$name" \
      "$glyph" \
      "$status_text" \
      "$remote_display" >> "$CACHE_FILE"
  done
}

open_local() {
  local path=$(expand_path "$1"); [[ -z "$path" ]] && return
  yazi "$path"
}

open_remote() {
  local path=$(expand_path "$1"); [[ -z "$path" ]] && return
  local repo_root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)
  [[ -z "$repo_root" ]] && return

  local remote_url=$(git -C "$repo_root" remote get-url origin 2>/dev/null)
  if [[ "$remote_url" =~ "git@" ]]; then
    remote_url=$(echo "$remote_url" | sed -e 's|:|/|' -e 's|git@|https://|' -e 's|\.git$||')
  fi
  xdg-open "$remote_url" &>/dev/null &
}

case "${1:-}" in
  --local) open_local "$2" ;;
  --remote) open_remote "$2" ;;
  *)
    generate_cache
    NAV_HELP=$(printf "\e[1;33mbcv\e[0m  \e[1;34menter\e[0m Local  \e[1;34mctrl-r\e[0m Remote")

    scan_vault | sed "s|^$HOME|~|" | fzf \
      --layout=reverse --height=100% \
      --border=top \
      --border-label=" $NAV_HELP " \
      --border-label-pos=3 \
      --prompt='  bcv 󰁔 ' \
      --preview="cat $CACHE_FILE" \
      --preview-window='bottom:80%:wrap:border-top' \
      --bind="enter:execute($BCV_PATH --local {})" \
      --bind="ctrl-r:execute-silent($BCV_PATH --remote {})" \
      2>/dev/null || true
    ;;
esac

// The ascii on ~/.local/share/fastfetch/ascii/
// This config on ~/.local/share/fastfetch/presets/
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
	        "top": 1,
          "left": 1
	},
        "color": {
          "1": "yellow",
          "2": "magenta"
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	// "title",
  {
	    "type": "title",
	    "format": "\u001b[34m{user-name}\u001b[35m@\u001b[33m{host-name}\u001b[0m"
	},
        {
            "type": "os",
            "key": "󰋑",
            "keyColor": "33",
            "format": "{2}",
        },
        {
            "type": "kernel",
            "format": "{2}",
            "key": "",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "",
            "keyColor": "33",  
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "󰥔",
            "keyColor": "33",
        },
        {
            "type": "memory",
            "key": "󰍛",
            "keyColor": "33",
        },
        {
            "type": "colors",
            "key": "󰏘",
            "symbol": "circle",
            "keyColor": "33",
        },
        "break",
    ]
}

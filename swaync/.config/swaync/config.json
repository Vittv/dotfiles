{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",

  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,

  "control-center-width": 400,
  "control-center-height": 350,
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,

  "notification-window-width": 380,
  "notification-icon-size": 50,
  "notification-body-image-height": 200,
  "notification-body-image-width": 200,

  "timeout": 8,
  "timeout-low": 6,
  "timeout-critical": 0,

  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "",
  "script-fail-notify": true,
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "buttons-grid",
    "title",
    "notifications"
  ],
  "widget-config": {
    "mpris": {
      "image-size": 50,
      "image-radius": 0
    },
    "volume": {
      "label": " 󰕾 ",
      "expand-button-label": "",
      "collapse-button-label": "",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " 󰆴 "
    },
    "buttons-grid": {
      "actions": [
        {
          "label": " ",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli r wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "sh -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) pactl set-source-mute @DEFAULT_SOURCE@ toggle'",
          "update-command": "sh -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes && echo true || echo false'"
        },
        {
          "label": " ",
          "type": "toggle",
          "active": false,
          "command": "sh -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) pactl set-source-mute @DEFAULT_SOURCE@ toggle && pkill -RTMIN+8 waybar'",
          "update-command": "sh -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes && echo true || echo false'"
        },
        {
          "label": " ",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && pactl set-sink-mute @DEFAULT_SINK@ 1 || pactl set-sink-mute @DEFAULT_SINK@ 0'",
          "update-command": "sh -c '[[ $(pactl get-sink-mute @DEFAULT_SINK@) == *yes* ]] && echo true || echo false'"
        },
        {
          "label": " ",
          "type": "toggle",
          "active": false,
          "command": "swaync-client --toggle-dnd",
          "update-command": "swaync-client --get-dnd"
        }
      ]
    }
  }
}

@import "~/.config/colors/schemes/vague/colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "󰍉 ";
    display-run: "󰍉 ";
    display-window: "󰍉 ";
    drun-display-format: "{name}";
    font: "SF Pro Display Medium 13";
    // font: "JetBrainsMono Nerd Font Propo SemiBold 12";
    terminal: "kitty";
}

* {
    /* Use system colors */
    background-color: transparent;
    text-color: @fg;
    handle-color: @accent;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 1px;
    border-color: @bg-alt;
    border-radius: 10px;
    width: 340px;
    padding: 8px;

    animation: "expand-vertical";
    animation-duration: 300;
}

mainbox {
    background-color: transparent;
    spacing: 0px;
    border: 0;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: transparent;
    border: 0px 0px 1px 0px;
    border-color: @bg-alt;
    padding: 12px;
    margin: 0px 0px 8px 0px;
    spacing: 4px;
    children: [prompt, entry];
}

prompt {
    text-color: @fg-dim;
    background-color: transparent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    background-color: transparent;
    text-color: @accent;
}

listview {
    background-color: transparent;
    lines: 7;
    spacing: 4px;
    cycle: false;
    scrollbar: false;
    border: 0;

    // This will make things open with a certain animation
    // With disabled animations, it should probably be commented out
    dynamic: true;
    fixed-height: false;
    expand: true;
}

element {
    background-color: transparent;
    padding: 10px;
    // border: 1px 0px 0px 0px;
    border-color: @bg-selected;
    border-radius: 0px;
    spacing: 12px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: transparent;
    border-radius: 6px;
    text-color: @accent;
    // border: 1px;
    border-color: @bg-alt;
    // background-color: transparent;
    // text-color: @accent;
}

element-icon {
    size: 12px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

scrollbar {
    border-radius: 10px;
    border-color: @bg-selected;
    background-color: @bg-alt;
    handle-width: 2px;
    handle-rounded-corners: true;
    handle-color: @bg-selected;
}
